# SERVER REFERENCE ONLY — do not upload this template as a secrets file.
# Existing LoveKoala secrets stay in Supabase; changing hosting does not remove them.
SITE_URL=https://lovekoala.com.br
ALLOWED_ORIGINS=https://lovekoala.com.br,https://www.lovekoala.com.br,https://lovekoala.contatodaflonedu.chatgpt.site,http://localhost:4173
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCOSULPAY_API_KEY=
MERCOSULPAY_WEBHOOK_SECRET=
MERCOSULPAY_ENABLED=true
MERCOSULPAY_API_BASE=https://mercosulpay.com/api/public/v1
# Conversation only. The existing GLM key remains server-side.
NVIDIA_CHAT_API_KEY=
# Image generation is paused in code; no image endpoint/key is needed.
# Do not replace RATE_LIMIT_SALT or CRON_SECRET without synchronizing the database Vault.
RATE_LIMIT_SALT=
CRON_SECRET=
# Optional music API, not required for the current public metadata search.
YOUTUBE_API_KEY=
# Optional transactional checkout summaries; a verified sender is required.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_ENABLED=false
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase itself.
